+def sdpa_cross_attention(q, k, v, lengths, text_length):
+    import torch
+    from torch.nn.functional import scaled_dot_product_attention
+
+    outputs = []
+    for batch, segments in enumerate(lengths):
+        rows = []
+        start = 0
+        for index, length in enumerate(segments):
+            queries = q[batch:batch + 1, start:start + length].transpose(1, 2)
